<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Inicio de sesión{% endblock %}</title>
        <style>
            :root { color-scheme: light; font-family: system-ui, sans-serif; color: #172033; background: #f3f5f9; }
            body { min-height: 100vh; display: grid; place-items: center; margin: 0; }
            main { box-sizing: border-box; width: min(100% - 2rem, 28rem); padding: 2rem; background: #fff; border-radius: 1rem; box-shadow: 0 1rem 3rem #17203312; }
            h1 { margin-top: 0; }
            .field { margin: 1.5rem 0; }
            label { display: block; margin-bottom: .5rem; font-weight: 600; }
            input { box-sizing: border-box; width: 100%; padding: .8rem; border: 1px solid #cbd2df; border-radius: .5rem; font: inherit; }
            button { width: 100%; padding: .85rem 1rem; border: 0; border-radius: .5rem; background: #3157d5; color: #fff; font: inherit; font-weight: 700; cursor: pointer; }
            .flash { margin: 1rem 0; padding: .8rem 1rem; border-radius: .5rem; }
            .flash-success { background: #e8f7ed; color: #176b36; }
            .flash-error, .form-error { background: #fff0ef; color: #a52c25; }
            .form-error { margin-top: .5rem; }
            form ul { padding-left: 1.2rem; }
        </style>
    </head>
    <body>
        <main>
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash flash-{{ label }}" role="status">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>
    </body>
</html>
