<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Inicio de sesión{% endblock %}</title>
        <link rel="stylesheet" href="/css/estilos.css">
    </head>
    <body>
        <main>
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    {% set claseMensaje = label == 'success' ? 'mensaje-exito' : 'mensaje-error' %}
                    <div class="mensaje-aviso {{ claseMensaje }}" role="status">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>
    </body>
</html>
